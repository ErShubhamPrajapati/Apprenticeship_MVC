
@{
    ViewBag.Title = "Index";
}

@{
    string[] Name = { "Rahul", "Amit", "Shubham", "Priya", "Rohit", "Neha", "Ankit", "Pooja" };
    string[] Department = { "IT", "HR", "Sales", "IT", "Finance", "HR", "IT", "Sales" };
    int[] Salary = { 25000, 35000, 45000, 28000, 50000, 30000, 40000, 32000 };
    <h2>Employee Salary Details</h2>
<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Salary</th>
    </tr>

    @for(int i=0; i < Name.Length; i++)
            {
    if (Salary[i] > 30000)
                {
                    <tr>
                      
                        <td>@(i+1)</td>
                        <td>@Name[i]</td>
                        <td>@Department[i]</td>
                        <td>₹@Salary[i]</td>
                        
                    </tr>
                }
            }
</table>
}

