
@{
    ViewBag.Title = "Index";
}
@*Question 6*@


@{
    string[] ProductName = { "Laptop", "Mouse", "Keyboard", "Monitor", "Mobile" };
    int[] Price = { 50000, 500, 1000, 12000, 15000 };
    string[] Category = {"Electronics", "Accessories", "Accessories","Electronics", "Electronics"};
    int[] Quantity = { 5, 10, 8, 4, 6 };
    <h2>Product Details</h2>
    <table border="1" cellpadding="10">
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Product Price</th>
            <th>Product Category</th>
            <th>Product Quantity</th>
        </tr>
        @for(int i=0; i < ProductName.Length; i++)
            {
                <tr>
                    <th>@(i+1)</th>
                    <th>@ProductName[i]</th>
                    <th>@Price[i]</th>
                    <th>@Category[i]</th>
                    <th>@Quantity[i]</th>
                </tr>
            }
    </table>

}
