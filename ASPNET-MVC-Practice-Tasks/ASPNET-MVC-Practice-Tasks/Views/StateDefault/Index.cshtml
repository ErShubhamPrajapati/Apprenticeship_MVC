
@{
    ViewBag.Title = "Index";
}

@*Question 4*@
@{
    string[] state = { "Uttar Pradesh", "Maharashtra", "Rajasthan", "Gujarat", "Bihar", "Madhya Pradesh", };
    <h2>Select an Indian State</h2>
    <select name="state">
        <option value="">-- Select State --</option>
        @foreach (string b in state)
        {
            if (b == "Uttar Pradesh")
            {
                    <option value="@b" selected>@b</option>
                }
            else
                {
                    <option value="@b">@b</option>
                }

        }
    </select>
}


