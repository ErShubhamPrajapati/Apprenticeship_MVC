
@{
    ViewBag.Title = "Index";
}

@{
    string[] Name = { "Rahul", "Amit", "Shubham", "Priya", "Rohit" };
    string[] Department = { "IT", "HR", "Sales", "IT", "Finance" };
    int[] Salary = { 25000, 30000, 28000, 35000, 40000 };
    <h2>Employee Details</h2>

    <table border="1" cellpadding="10">
        <tr>
            <th>Employee ID</th>
            <th>Employee Name</th>
            <th>Employee Department</th>
            <th>Employee Salary</th>
        </tr>
        @for(int i = 0; i < Name.Length; i++)
            {
                <tr>
                    <td>@(i+1)</td>
                    <td>@Name[i]</td>
                    <td>@Department[i]</td>
                    <td>@Salary[i]</td>
                </tr>
            }
    </table>
}


