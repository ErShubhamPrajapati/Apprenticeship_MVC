
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        .shopping-navbar {
            background: linear-gradient(135deg, #198754, #146c43);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

            .shopping-navbar .navbar-brand {
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
            }

                .shopping-navbar .navbar-brand i {
                    margin-right: 8px;
                }

            .shopping-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                font-weight: 500;
                padding: 10px 12px !important;
                border-radius: 6px;
                transition: 0.3s;
            }

                .shopping-navbar .nav-link:hover,
                .shopping-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

                .shopping-navbar .nav-link i {
                    margin-right: 5px;
                }

            .shopping-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

            .shopping-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }
    </style>

</head>

<body>

    <!-- Shopping Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark shopping-navbar">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand"
               href="@Url.Action("Index", "Shopping")">

                <i class="bi bi-cart-fill"></i>
                Online Shopping

            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#shoppingNavbar"
                    aria-controls="shoppingNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="shoppingNavbar">

                <ul class="navbar-nav ms-auto">

                    <!-- 1. Index -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Shopping")">

                            <i class="bi bi-house-door"></i>
                            Home

                        </a>
                    </li>

                    <!-- 2. Products -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Products", "Shopping")">

                            <i class="bi bi-box-seam"></i>
                            Products

                        </a>
                    </li>

                    <!-- 3. Categories -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Categories", "Shopping")">

                            <i class="bi bi-grid"></i>
                            Categories

                        </a>
                    </li>

                    <!-- 4. ProductDetails -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("ProductDetails", "Shopping")">

                            <i class="bi bi-info-circle"></i>
                            Product Details

                        </a>
                    </li>

                    <!-- 5. Cart -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Cart", "Shopping")">

                            <i class="bi bi-cart3"></i>
                            Cart

                        </a>
                    </li>

                    <!-- 6. Wishlist -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Wishlist", "Shopping")">

                            <i class="bi bi-heart"></i>
                            Wishlist

                        </a>
                    </li>

                    <!-- 7. Checkout -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Checkout", "Shopping")">

                            <i class="bi bi-credit-card"></i>
                            Checkout

                        </a>
                    </li>

                    <!-- 8. Orders -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Orders", "Shopping")">

                            <i class="bi bi-bag-check"></i>
                            Orders

                        </a>
                    </li>

                    <!-- 9. Offers -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Offers", "Shopping")">

                            <i class="bi bi-tags"></i>
                            Offers

                        </a>
                    </li>

                    <!-- 10. CustomerSupport -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("CustomerSupport", "Shopping")">

                            <i class="bi bi-headset"></i>
                            Support

                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- View Content -->
    <div>
        @RenderBody()
    </div>

</body>
</html>
