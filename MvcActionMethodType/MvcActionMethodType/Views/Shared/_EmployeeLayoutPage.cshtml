<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        .employee-navbar {
            background: linear-gradient(135deg, #198754, #146c43);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

            .employee-navbar .navbar-brand {
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
            }

                .employee-navbar .navbar-brand i {
                    margin-right: 8px;
                }

            .employee-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                font-weight: 500;
                padding: 10px 12px !important;
                border-radius: 6px;
                transition: 0.3s;
            }

                .employee-navbar .nav-link:hover,
                .employee-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

                .employee-navbar .nav-link i {
                    margin-right: 5px;
                }

            .employee-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

            .employee-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }
    </style>
</head>
<body>

    <!-- Employee Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark employee-navbar">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand" href="@Url.Action("Index", "Employee")">
                <i class="bi bi-people-fill"></i>
                Employee Portal
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#employeeNavbar"
                    aria-controls="employeeNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="employeeNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Employee")">
                            <i class="bi bi-house-door"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Create", "Employee")">
                            <i class="bi bi-person-plus"></i>
                            Create
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Edit", "Employee")">
                            <i class="bi bi-pencil-square"></i>
                            Edit
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Details", "Employee")">
                            <i class="bi bi-info-circle"></i>
                            Details
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("List", "Employee")">
                            <i class="bi bi-list-ul"></i>
                            Employee List
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Department", "Employee")">
                            <i class="bi bi-building"></i>
                            Department
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Designation", "Employee")">
                            <i class="bi bi-briefcase"></i>
                            Designation
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Salary", "Employee")">
                            <i class="bi bi-currency-rupee"></i>
                            Salary
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Experience", "Employee")">
                            <i class="bi bi-award"></i>
                            Experience
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("EmployeeProfile", "Employee")">
                            <i class="bi bi-person-circle"></i>
                            Profile
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div>
        @RenderBody()
    </div>
    
</body>
</html>
