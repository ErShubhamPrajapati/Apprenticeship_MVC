
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        .hospital-navbar {
            background: linear-gradient(135deg, #198754, #146c43);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

            .hospital-navbar .navbar-brand {
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
            }

                .hospital-navbar .navbar-brand i {
                    margin-right: 8px;
                }

            .hospital-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                font-weight: 500;
                padding: 10px 12px !important;
                border-radius: 6px;
                transition: 0.3s;
            }

                .hospital-navbar .nav-link:hover,
                .hospital-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

                .hospital-navbar .nav-link i {
                    margin-right: 5px;
                }

            .hospital-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

            .hospital-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }
    </style>

</head>

<body>

    <!-- Hospital Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark hospital-navbar">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand"
               href="@Url.Action("Index", "Hospital")">

                <i class="bi bi-hospital"></i>
                Hospital Management

            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#hospitalNavbar"
                    aria-controls="hospitalNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="hospitalNavbar">

                <ul class="navbar-nav ms-auto">

                    <!-- 1. Index -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Hospital")">

                            <i class="bi bi-house-door"></i>
                            Dashboard

                        </a>
                    </li>

                    <!-- 2. Doctors -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Doctors", "Hospital")">

                            <i class="bi bi-person-badge"></i>
                            Doctors

                        </a>
                    </li>

                    <!-- 3. Patients -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Patients", "Hospital")">

                            <i class="bi bi-people"></i>
                            Patients

                        </a>
                    </li>

                    <!-- 4. Appointments -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Appointments", "Hospital")">

                            <i class="bi bi-calendar-check"></i>
                            Appointments

                        </a>
                    </li>

                    <!-- 5. Departments -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Departments", "Hospital")">

                            <i class="bi bi-building"></i>
                            Departments

                        </a>
                    </li>

                    <!-- 6. Services -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Services", "Hospital")">

                            <i class="bi bi-heart-pulse"></i>
                            Services

                        </a>
                    </li>

                    <!-- 7. Wards -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Wards", "Hospital")">

                            <i class="bi bi-hospital"></i>
                            Wards

                        </a>
                    </li>

                    <!-- 8. Medicines -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Medicines", "Hospital")">

                            <i class="bi bi-capsule"></i>
                            Medicines

                        </a>
                    </li>

                    <!-- 9. Billing -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Billing", "Hospital")">

                            <i class="bi bi-currency-rupee"></i>
                            Billing

                        </a>
                    </li>

                    <!-- 10. Contact -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Contact", "Hospital")">

                            <i class="bi bi-telephone"></i>
                            Contact

                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- View Content -->
    <div>
        @RenderBody()
    </div>

</body>
</html>
