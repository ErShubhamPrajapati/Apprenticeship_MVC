<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        body {
            background-color: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        .student-navbar {
            background: linear-gradient(135deg, #0d6efd, #084298);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

        .navbar-brand {
            font-size: 22px;
            font-weight: 700;
            color: white !important;
        }

            .navbar-brand i {
                margin-right: 8px;
            }

        .navbar-nav .nav-link {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 500;
            padding: 10px 12px !important;
            border-radius: 6px;
            transition: 0.3s;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                background-color: rgba(255, 255, 255, 0.18);
                color: white;
            }

            .navbar-nav .nav-link i {
                margin-right: 5px;
            }

        .student-content {
            padding: 25px;
            min-height: 85vh;
        }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.5);
        }

        .navbar-toggler-icon {
            filter: brightness(0) invert(1);
        }

        /* Student Footer */

        .student-footer {
            background: #0b1f3a;
            color: #ffffff;
            margin-top: 30px;
        }

        .footer-heading {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #ffffff;
        }

        .footer-text {
            color: #b8c5d6;
            font-size: 14px;
            line-height: 1.8;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-links li {
                margin-bottom: 12px;
            }

            .footer-links a {
                color: #b8c5d6;
                text-decoration: none;
                font-size: 14px;
                transition: 0.3s;
            }

                .footer-links a:hover {
                    color: #0d6efd;
                    padding-left: 5px;
                }

        .footer-contact {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-contact li {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                color: #b8c5d6;
                font-size: 14px;
                margin-bottom: 15px;
            }

            .footer-contact i {
                color: #0d6efd;
                font-size: 17px;
            }

        .footer-social {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

            .footer-social a {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
                background: #1c3555;
                color: #ffffff;
                border-radius: 50%;
                text-decoration: none;
                transition: 0.3s;
            }

                .footer-social a:hover {
                    background: #0d6efd;
                    transform: translateY(-3px);
                }

        .footer-divider {
            border-color: #31445d;
            margin: 30px 0 20px;
        }

        .copyright-text {
            color: #9aacc2;
            font-size: 13px;
        }

        /* Responsive Footer */

        @@media (max-width: 767px) {

            .student-footer {
                text-align: center;
            }

            .footer-social {
                justify-content: center;
            }

            .footer-contact li {
                justify-content: center;
            }
        }
    </style>

</head>
<body>
    <!-- Student Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark student-navbar">
        <div class="container-fluid px-4">

            <!-- Logo -->
            <a class="navbar-brand" href="@Url.Action("Index", "Student")">
                <i class="bi bi-mortarboard-fill"></i>
                Student Portal
            </a>

            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#studentNavbar"
                    aria-controls="studentNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="studentNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Student")">
                            <i class="bi bi-house-door"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Admission", "Student")">
                            <i class="bi bi-person-plus"></i>
                            Admission
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Registration", "Student")">
                            <i class="bi bi-card-checklist"></i>
                            Registration
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Profile", "Student")">
                            <i class="bi bi-person-circle"></i>
                            Profile
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Courses", "Student")">
                            <i class="bi bi-book"></i>
                            Courses
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Attendance", "Student")">
                            <i class="bi bi-calendar-check"></i>
                            Attendance
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Results", "Student")">
                            <i class="bi bi-bar-chart"></i>
                            Results
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Assignments", "Student")">
                            <i class="bi bi-file-earmark-text"></i>
                            Assignments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Fees", "Student")">
                            <i class="bi bi-wallet2"></i>
                            Fees
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("StudentDetails", "Student")">
                            <i class="bi bi-info-circle"></i>
                            Student Details
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>
    <div>
        @RenderBody()
    </div>

    <!-- Student Footer -->
    <footer class="student-footer">

        <div class="container-fluid px-4 py-4">

            <div class="row g-4">

                <!-- About Section -->
                <div class="col-lg-4 col-md-6">

                    <h5 class="footer-heading">
                        <i class="bi bi-mortarboard-fill me-2"></i>
                        Student Portal
                    </h5>

                    <p class="footer-text">
                        Welcome to Student Portal. Manage your admission,
                        courses, attendance, results, assignments and fees
                        from one convenient platform.
                    </p>

                    <div class="footer-social">
                        <a href="#" aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#" aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="#" aria-label="Twitter">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                    </div>

                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">

                    <h5 class="footer-heading">Quick Links</h5>

                    <ul class="footer-links">
                        <li>
                            <a href="@Url.Action("Index", "Student")">
                                Dashboard
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Admission", "Student")">
                                Admission
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Registration", "Student")">
                                Registration
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Profile", "Student")">
                                My Profile
                            </a>
                        </li>
                    </ul>

                </div>

                <!-- Student Services -->
                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-heading">Student Services</h5>

                    <ul class="footer-links">
                        <li>
                            <a href="@Url.Action("Courses", "Student")">
                                Courses
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Attendance", "Student")">
                                Attendance
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Results", "Student")">
                                Results
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Assignments", "Student")">
                                Assignments
                            </a>
                        </li>

                        <li>
                            <a href="@Url.Action("Fees", "Student")">
                                Fees
                            </a>
                        </li>
                    </ul>

                </div>

                <!-- Contact Information -->
                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-heading">Contact Us</h5>

                    <ul class="footer-contact">

                        <li>
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>Your College Address</span>
                        </li>

                        <li>
                            <i class="bi bi-envelope-fill"></i>
                            <span>studentportal@gmail.com</span>
                        </li>

                        <li>
                            <i class="bi bi-telephone-fill"></i>
                            <span>+91 9876543210</span>
                        </li>

                    </ul>

                </div>

            </div>

            <!-- Copyright -->
            <hr class="footer-divider" />

            <div class="row align-items-center">

                <div class="col-md-6 text-center text-md-start">
                    <p class="copyright-text mb-0">
                        &copy; @DateTime.Now.Year Student Portal.
                        All Rights Reserved.
                    </p>
                </div>

                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <p class="copyright-text mb-0">
                        Designed with
                        <i class="bi bi-heart-fill text-danger"></i>
                        using Bootstrap 5.3
                    </p>
                </div>

            </div>

        </div>

    </footer>

</body>
</html>
