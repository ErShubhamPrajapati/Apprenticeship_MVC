
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        .library-navbar {
            background: linear-gradient(135deg, #198754, #146c43);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

            .library-navbar .navbar-brand {
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
            }

                .library-navbar .navbar-brand i {
                    margin-right: 8px;
                }

            .library-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                font-weight: 500;
                padding: 10px 12px !important;
                border-radius: 6px;
                transition: 0.3s;
            }

                .library-navbar .nav-link:hover,
                .library-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

                .library-navbar .nav-link i {
                    margin-right: 5px;
                }

            .library-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

            .library-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }
    </style>

</head>

<body>

    <!-- Library Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark library-navbar">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand"
               href="@Url.Action("Index", "Library")">

                <i class="bi bi-book-half"></i>
                Library Management

            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#libraryNavbar"
                    aria-controls="libraryNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="libraryNavbar">

                <ul class="navbar-nav ms-auto">

                    <!-- 1. Index -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Library")">

                            <i class="bi bi-house-door"></i>
                            Home

                        </a>
                    </li>

                    <!-- 2. Books -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Books", "Library")">

                            <i class="bi bi-book"></i>
                            Books

                        </a>
                    </li>

                    <!-- 3. AddBook -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("AddBook", "Library")">

                            <i class="bi bi-plus-circle"></i>
                            Add Book

                        </a>
                    </li>

                    <!-- 4. BookDetails -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("BookDetails", "Library")">

                            <i class="bi bi-info-circle"></i>
                            Book Details

                        </a>
                    </li>

                    <!-- 5. Categories -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Categories", "Library")">

                            <i class="bi bi-grid"></i>
                            Categories

                        </a>
                    </li>

                    <!-- 6. Authors -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Authors", "Library")">

                            <i class="bi bi-person-lines-fill"></i>
                            Authors

                        </a>
                    </li>

                    <!-- 7. Members -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Members", "Library")">

                            <i class="bi bi-people"></i>
                            Members

                        </a>
                    </li>

                    <!-- 8. IssueBook -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("IssueBook", "Library")">

                            <i class="bi bi-journal-plus"></i>
                            Issue Book

                        </a>
                    </li>

                    <!-- 9. ReturnBook -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("ReturnBook", "Library")">

                            <i class="bi bi-arrow-return-left"></i>
                            Return Book

                        </a>
                    </li>

                    <!-- 10. FineDetails -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("FineDetails", "Library")">

                            <i class="bi bi-currency-rupee"></i>
                            Fine Details

                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- View Content -->
    <div>
        @RenderBody()
    </div>

</body>
</html>
