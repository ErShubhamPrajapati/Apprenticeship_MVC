<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
    <script src="~/Content/JS/bootstrap.bundle.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />


    <style>

        /* Product Navbar */

        .product-navbar {
            background: linear-gradient(135deg, #6f42c1, #4c2889);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        }

            .product-navbar .navbar-brand {
                font-size: 22px;
                font-weight: 700;
                color: #ffffff;
            }

                .product-navbar .navbar-brand i {
                    margin-right: 8px;
                }

            .product-navbar .nav-link {
                color: rgba(255, 255, 255, 0.9);
                font-size: 14px;
                font-weight: 500;
                padding: 10px 12px !important;
                border-radius: 6px;
                transition: 0.3s;
            }

                .product-navbar .nav-link:hover,
                .product-navbar .nav-link.active {
                    background: rgba(255, 255, 255, 0.18);
                    color: #ffffff;
                }

                .product-navbar .nav-link i {
                    margin-right: 5px;
                }

            .product-navbar .navbar-toggler {
                border-color: rgba(255, 255, 255, 0.5);
            }

            .product-navbar .navbar-toggler-icon {
                filter: brightness(0) invert(1);
            }
    </style>
</head>
<body>

    <!-- Product Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark product-navbar">

        <div class="container-fluid px-4">

            <!-- Brand -->
            <a class="navbar-brand"
               href="@Url.Action("Index", "Product")">

                <i class="bi bi-bag-fill"></i>
                Product Portal

            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#productNavbar"
                    aria-controls="productNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="productNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Index", "Product")">

                            <i class="bi bi-house-door"></i>
                            Dashboard

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("List", "Product")">

                            <i class="bi bi-grid"></i>
                            Product List

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Details", "Product")">

                            <i class="bi bi-info-circle"></i>
                            Details

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Categories", "Product")">

                            <i class="bi bi-tags"></i>
                            Categories

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Electronics", "Product")">

                            <i class="bi bi-laptop"></i>
                            Electronics

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Clothing", "Product")">

                            <i class="bi bi-bag"></i>
                            Clothing

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Books", "Product")">

                            <i class="bi bi-book"></i>
                            Books

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("Offers", "Product")">

                            <i class="bi bi-percent"></i>
                            Offers

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("NewArrivals", "Product")">

                            <i class="bi bi-stars"></i>
                            New Arrivals

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="@Url.Action("BestSellers", "Product")">

                            <i class="bi bi-trophy"></i>
                            Best Sellers

                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div>
        @RenderBody()
    </div>
</body>
</html>
